{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  // Upstream-derived node:test suites run through jiti (npm test) and are not
  // held to the fork's stricter tsc; upstream typechecks tests with strict:false.
  "include": ["./*.ts", "tests/*.ts"],
  "exclude": [
    "node_modules",
    "tests/notify.test.ts",
    "tests/provider.integration.test.ts"
  ]
}